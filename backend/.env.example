# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# OpenAI API key — required for the /agent/chat endpoint
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# JWT signing secret — override in production with a strong random value
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dentalai-dev-secret-change-in-prod

# --- M3 RAG (optional) -------------------------------------------------------
# Clinic knowledge lookup. Without both values the agent still works; the
# knowledge tool just replies that it is unavailable.
# Supabase Postgres with the pgvector extension. Use the *pooler* connection
# string from the Supabase dashboard, not the direct one.
RAG_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Cohere embeddings key (free trial key is enough)
COHERE_API_KEY=
# Optional tuning (defaults: 4 results, 0.40 minimum similarity, chosen from the
# retrieval eval output)
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.40
